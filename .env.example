# Copy this file to .env and use values from the Square Developer Console.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=sandbox-sq0idb-your-application-id
SQUARE_ACCESS_TOKEN=your-sandbox-access-token
SQUARE_LOCATION_ID=your-sandbox-location-id
SQUARE_API_VERSION=2026-08-19
PORT=3000
# Leave empty when Node is internet-facing. If a reverse proxy overwrites and
# appends X-Forwarded-For, list only that proxy's exact IP address(es).
TRUSTED_PROXY_IPS=
